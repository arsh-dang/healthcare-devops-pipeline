FROM nginx:1.25.3-alpine

# Create a simple HTML page
RUN echo '<!DOCTYPE html><html><head><title>Healthcare App</title></head><body><h1>Healthcare App Frontend</h1><p>Frontend is running successfully!</p></body></html>' > /usr/share/nginx/html/index.html

# Create a health check endpoint
RUN echo '{"status":"ok","service":"frontend","timestamp":"'$(date -u +%Y-%m-%dT%H:%M:%SZ)'"}' > /usr/share/nginx/html/health

# Create custom nginx config with health endpoint
RUN echo 'server { listen 80; location / { root /usr/share/nginx/html; index index.html; } location /health { return 200 '"'"'{"status":"ok","service":"frontend"}'"'"'; add_header Content-Type application/json; } }' > /etc/nginx/conf.d/default.conf

EXPOSE 80

# Keep nginx running on port 80 as expected by Kubernetes
CMD ["nginx", "-g", "daemon off;"]