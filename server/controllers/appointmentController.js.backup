const Appointment = require('../models/appointment');

// Get all appointments
exports.getAppointments = async (req, res) => {
  const span = req.span;
  if (span) {
    span.setTag('operation', 'get-appointments');
  }
  
  try {
    const appointments = await Appointment.find();
    if (span) {
      span.setTag('appointments.count', appointments.length);
    }
    res.status(200).json(appointments);
  } catch (error) {
    if (span) {
      span.setTag('error', true);
      span.setTag('error.message', error.message);
    }
    res.status(500).json({ message: error.message });
  }
};

// Create a new appointment
exports.createAppointment = async (req, res) => {
  const span = req.span;
  if (span) {
    span.setTag('operation', 'create-appointment');
    span.setTag('appointment.title', req.body.title);
  }
  
  const appointment = new Appointment(req.body);
  
  try {
    const newAppointment = await appointment.save();
    if (span) {
      span.setTag('appointment.id', newAppointment._id);
    }
    res.status(201).json(newAppointment);
  } catch (error) {
    if (span) {
      span.setTag('error', true);
      span.setTag('error.message', error.message);
    }
    res.status(400).json({ message: error.message });
  }
};

// Get appointment by ID
exports.getAppointmentById = async (req, res) => {
  try {
    const appointment = await Appointment.findById(req.params.id);
    if (!appointment) {
      return res.status(404).json({ message: 'Appointment not found' });
    }
    res.status(200).json(appointment);
  } catch (error) {
    res.status(500).json({ message: error.message });
  }
};

// Update appointment
exports.updateAppointment = async (req, res) => {
  try {
    const appointment = await Appointment.findByIdAndUpdate(
      req.params.id, 
      req.body,
      { new: true }
    );
    if (!appointment) {
      return res.status(404).json({ message: 'Appointment not found' });
    }
    res.status(200).json(appointment);
  } catch (error) {
    res.status(400).json({ message: error.message });
  }
};

// Delete appointment
exports.deleteAppointment = async (req, res) => {
  const span = req.span;
  if (span) {
    span.setTag('operation', 'delete-appointment');
    span.setTag('appointment.id', req.params.id);
  }
  
  try {
    const appointment = await Appointment.findByIdAndDelete(req.params.id);
    if (!appointment) {
      if (span) {
        span.setTag('error', true);
        span.setTag('error.message', 'Appointment not found');
      }
      return res.status(404).json({ message: 'Appointment not found' });
    }
    if (span) {
      span.setTag('appointment.deleted', true);
    }
    res.status(200).json({ message: 'Appointment deleted successfully' });
  } catch (error) {
    if (span) {
      span.setTag('error', true);
      span.setTag('error.message', error.message);
    }
    res.status(500).json({ message: error.message });
  }
};