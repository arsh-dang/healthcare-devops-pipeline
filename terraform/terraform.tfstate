        {
          "schema_version": 0,
          "attributes": {
            "binary_data": {},
            "data": {
              "dashboard-providers.yml": "\"apiVersion\": 1\n\"providers\":\n- \"folder\": \"\"\n  \"name\": \"default\"\n  \"options\":\n    \"path\": \"/etc/grafana/provisioning/dashboards\"\n  \"orgId\": 1\n  \"type\": \"file\"\n",
              "datasources.yml": "\"apiVersion\": 1\n\"datasources\":\n- \"access\": \"proxy\"\n  \"isDefault\": true\n  \"name\": \"Prometheus\"\n  \"type\": \"prometheus\"\n  \"url\": \"http://prometheus:9090\"\n",
              "grafana.ini": "[server]\nhttp_port = 3000\nroot_url = http://localhost:30285/staging/grafana/\n\n[database]\ntype = sqlite3\npath = /var/lib/grafana/grafana.db\n\n[security]\nadmin_user = admin\nadmin_password = admin123\n\n[auth.anonymous]\nenabled = true\norg_role = Viewer\n\n[dashboards]\ndefault_home_dashboard_path = /etc/grafana/provisioning/dashboards/healthcare-dashboard.json\n",
              "healthcare-dashboard.json": "{\"id\":null,\"panels\":[{\"id\":1,\"targets\":[{\"expr\":\"rate(container_cpu_usage_seconds_total{namespace=\\\"healthcare-staging\\\"}[5m]) * 100\"}],\"title\":\"CPU Usage\",\"type\":\"graph\",\"yAxes\":[{\"label\":\"Percentage\",\"max\":100}]},{\"id\":2,\"targets\":[{\"expr\":\"container_memory_usage_bytes{namespace=\\\"healthcare-staging\\\"} / 1024 / 1024\"}],\"title\":\"Memory Usage\",\"type\":\"graph\",\"yAxes\":[{\"label\":\"MB\"}]},{\"id\":3,\"targets\":[{\"expr\":\"rate(http_requests_total{job=\\\"healthcare-backend\\\"}[5m])\"}],\"title\":\"HTTP Request Rate\",\"type\":\"graph\"},{\"id\":4,\"targets\":[{\"expr\":\"histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\\\"healthcare-backend\\\"}[5m]))\"}],\"title\":\"Response Time (95th percentile)\",\"type\":\"graph\"}],\"refresh\":\"30s\",\"tags\":[\"healthcare\",\"monitoring\"],\"time\":{\"from\":\"now-1h\",\"to\":\"now\"},\"timezone\":\"browser\",\"title\":\"Healthcare Application Dashboard\"}"
            },
            "id": "monitoring-staging/grafana-config",
            "immutable": false,
            "metadata": [
              {
                "annotations": {},
                "generate_name": "",
                "generation": 0,
