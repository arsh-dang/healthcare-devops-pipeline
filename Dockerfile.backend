# Use Node.js with Debian base (includes curl by default)
FROM node:20-slim

# Install curl if not present (Debian slim usually has it)
RUN apt-get update && \
    apt-get install -y curl && \
    rm -rf /var/lib/apt/lists/*

# Install pnpm globally
RUN npm install -g pnpm --registry=https://registry.npmjs.org/ && \
    npm cache clean --force

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN if command -v pnpm >/dev/null 2>&1; then \
        echo "Using pnpm for dependency installation..." && \
        pnpm install --frozen-lockfile --prod; \
    else \
        echo "Using npm for dependency installation..." && \
        npm install --production; \
    fi

# Copy server files
COPY server/ ./server/

# Expose the port the app runs on
EXPOSE 5001

# Command to run the application
CMD ["node", "server/server.js"]