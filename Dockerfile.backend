FROM node:20-alpine

# Accept build arguments
ARG NODE_OPTIONS="--max-old-space-size=4096"

WORKDIR /app

# Set Node.js options for memory management
ENV NODE_OPTIONS=${NODE_OPTIONS}

# Copy package files
COPY package*.json ./
COPY pnpm-lock.yaml* ./

# Install dependencies
RUN if [ -f pnpm-lock.yaml ]; then npm install -g pnpm && pnpm install; else npm install --legacy-peer-deps; fi

# Copy server source code
COPY server/ ./server/
COPY .env* ./

# Create a simple package.json for the backend service
RUN echo '{"name":"healthcare-app-backend","version":"1.0.0","main":"server/server.js","scripts":{"start":"node server/server.js"}}' > package.json

# Install production dependencies only
RUN if [ -f pnpm-lock.yaml ]; then pnpm install --production; else npm install --production; fi

# Create environment file if it doesn't exist
RUN if [ ! -f .env ]; then echo 'NODE_ENV=production\nPORT=5001\nMONGODB_HOST=mongodb\nMONGODB_PORT=27017\nMONGODB_DATABASE=healthcare-app' > .env; fi

EXPOSE 5001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:5001/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

CMD ["npm", "start"]