FROM node:20-alpine

WORKDIR /app

# Create a simple package.json
RUN echo '{"name":"healthcare-app-backend","version":"1.0.0","main":"index.js","scripts":{"start":"node index.js"}}' > package.json

# Create a simple Express.js application with endpoints for integration tests
RUN echo 'const express = require("express"); const app = express(); app.use(express.json()); app.get("/health", (req, res) => res.json({status: "ok"})); app.get("/api/health", (req, res) => res.json({status: "ok"})); app.get("/api/appointments", (req, res) => res.json([])); app.post("/api/appointments", (req, res) => res.status(201).json({_id: "test-id", ...req.body})); app.delete("/api/appointments/:id", (req, res) => res.status(200).json({message: "deleted"})); app.listen(5001, () => console.log("Backend running on port 5001"));' > index.js

# Install Express and axios
RUN npm install express axios

EXPOSE 5001

CMD ["npm", "start"]